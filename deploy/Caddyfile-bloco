# Família Linu (Seiabras/familia-linu, 07/11/2026): o endereço que junta os irmãos e a identidade da família
familia.linupedia.com.br {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' https://farol.linupedia.com.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@arquivos path /img/* /fontes/* /css/* /js/*
	header @arquivos Cache-Control "public, max-age=604800"
	root * /opt/familia-linu/app
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		@nao_achei expression {err.status_code} == 404
		rewrite @nao_achei /404.html
		file_server
	}
}

# O /identidade de cada irmão leva para a identidade da família (decisão de 07/11/2026). Dentro do bloco de cada um:
#   redir /identidade https://familia.linupedia.com.br/identidade 301
